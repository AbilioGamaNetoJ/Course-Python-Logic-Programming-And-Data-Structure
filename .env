# ============================================================================
# CONFIGURAÇÕES DO SISTEMA DE GESTÃO EMPRESARIAL
# ============================================================================
# Este arquivo contém todas as variáveis de ambiente necessárias para o sistema.
# Copie este arquivo para .env e configure os valores apropriados.

# ============================================================================
# CONFIGURAÇÕES DE LOGGING
# ============================================================================
# Nível de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Arquivo de log do sistema
LOG_FILE=sistema_gestao.log

# Formato das mensagens de log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Habilitar log no console (true/false)
LOG_CONSOLE=true

# ============================================================================
# CONFIGURAÇÕES DE BACKUP
# ============================================================================
# Diretório padrão para backups
BACKUP_DIR=./backups

# Formato padrão de backup (json/csv)
BACKUP_FORMAT=json

# Backup automático habilitado (true/false)
AUTO_BACKUP=false

# Intervalo de backup automático em horas
BACKUP_INTERVAL=24

# ============================================================================
# CONFIGURAÇÕES DO SISTEMA
# ============================================================================
# Nome da aplicação
APP_NAME=Sistema de Gestão Empresarial

# Versão da aplicação
APP_VERSION=1.0.0

# Ambiente de execução (development/production/test)
ENVIRONMENT=development

# Inicializar com dados de exemplo (true/false)
INIT_SAMPLE_DATA=true

# ============================================================================
# CONFIGURAÇÕES DE DADOS
# ============================================================================
# Estoque mínimo padrão para produtos
DEFAULT_MIN_STOCK=5

# Limite de crédito padrão para clientes
DEFAULT_CREDIT_LIMIT=1000.0

# Desconto máximo permitido (%)
MAX_DISCOUNT_PERCENT=50.0

# ============================================================================
# CONFIGURAÇÕES DE PERFORMANCE
# ============================================================================
# Tamanho máximo de cache em memória
MAX_CACHE_SIZE=1000

# Timeout para operações em segundos
OPERATION_TIMEOUT=30

# Número máximo de threads
MAX_THREADS=4

# ============================================================================
# CONFIGURAÇÕES DE SEGURANÇA
# ============================================================================
# Chave secreta para hash (ALTERE EM PRODUÇÃO!)
SECRET_KEY=sua-chave-secreta-super-segura-aqui

# Salt para senhas (ALTERE EM PRODUÇÃO!)
PASSWORD_SALT=seu-salt-unico-aqui

# ============================================================================
# CONFIGURAÇÕES DE INTERFACE
# ============================================================================
# Número de itens por página
ITEMS_PER_PAGE=10

# Timeout da interface em segundos
UI_TIMEOUT=300

# Tema da interface (light/dark)
UI_THEME=light