# CONFIGURAÇÕES DO SISTEMA DE GESTÃO EMPRESARIAL
# ===============================================
# 
# Este arquivo contém todas as variáveis de ambiente necessárias para o sistema.
# Copie este arquivo para .env e configure os valores apropriados.
# 
# IMPORTANTE: Nunca commite o arquivo .env com valores reais!

# CONFIGURAÇÕES DE LOGGING
# ========================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=sistema_gestao.log
LOG_CONSOLE=true
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# CONFIGURAÇÕES DE BANCO DE DADOS
# ===============================
DB_TYPE=memory
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestao_empresarial
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=10
DB_TIMEOUT=30

# CONFIGURAÇÕES DE NEGÓCIO
# ========================
DEFAULT_CREDIT_LIMIT=5000.0
MIN_STOCK_LEVEL=5
MAX_ITEMS_PER_ORDER=100
CURRENCY=BRL
TAX_RATE=0.18
DISCOUNT_THRESHOLD=1000.0
DISCOUNT_RATE=0.05
MIN_PRODUCT_PRICE=0.01
MAX_PRODUCT_PRICE=999999.99
MIN_CUSTOMER_AGE=18
MAX_CUSTOMER_NAME_LENGTH=100

# CONFIGURAÇÕES DE SEGURANÇA
# ==========================
PASSWORD_MIN_LENGTH=8
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=3
LOCKOUT_DURATION=900
ENCRYPTION_KEY=your-encryption-key-here
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRATION=86400

# CONFIGURAÇÕES DO SISTEMA
# ========================
APP_NAME=Sistema de Gestão Empresarial
APP_VERSION=1.0.0
DEBUG_MODE=false
INIT_SAMPLE_DATA=true
BACKUP_DIR=backups
EXPORT_DIR=exports
TEMP_DIR=temp
MAX_FILE_UPLOAD_SIZE=52428800
CACHE_ENABLED=true
CACHE_TTL=3600
PAGINATION_SIZE=50
MAX_SEARCH_RESULTS=1000

# CONFIGURAÇÕES ESPECÍFICAS DE AMBIENTE
# =====================================
# Descomente e configure conforme necessário:

# Para ambiente de desenvolvimento:
# DEBUG_MODE=true
# LOG_LEVEL=DEBUG
# INIT_SAMPLE_DATA=true

# Para ambiente de produção:
# DEBUG_MODE=false
# LOG_LEVEL=WARNING
# INIT_SAMPLE_DATA=false
# DB_TYPE=postgresql
# DB_HOST=your-production-db-host
# DB_USER=your-production-db-user
# DB_PASSWORD=your-production-db-password

# Para ambiente de teste:
# DEBUG_MODE=true
# LOG_LEVEL=DEBUG
# DB_TYPE=memory
# INIT_SAMPLE_DATA=false